# syntax=docker/dockerfile:1.7

FROM golang:1.26.2-bookworm AS builder

ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOMAXPROCS=1

WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -p 1 -tags goolm -o /out/mautrix-snapchat-bridgev2 ./cmd/mautrix-snapchat-bridgev2

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /data
COPY --from=builder /out/mautrix-snapchat-bridgev2 /usr/local/bin/mautrix-snapchat-bridgev2

EXPOSE 4000
ENTRYPOINT ["/usr/local/bin/mautrix-snapchat-bridgev2"]
CMD ["-c", "/data/config.yaml"]
